<Window x:Class="Overdub.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Overdub.App"
        Title="Overdub" Icon="Assets/overdub.ico" Width="1100" Height="580" MinWidth="1060" MinHeight="400"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="13" PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource TransportButton}" Command="{Binding StopCommand}" Content="■" ToolTip="Stop" />
                <Button Style="{StaticResource TransportButton}" Command="{Binding PlayCommand}" Content="▶" ToolTip="Play or pause (Space)" />
                <Button Style="{StaticResource TransportButton}" Command="{Binding RecordCommand}" Content="●" Foreground="{StaticResource Danger}" ToolTip="Record (R)" />
                <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="24" VerticalAlignment="Center" Margin="14,0,16,0" />
                <TextBlock Text="{Binding Bar}" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ChordText}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Good}" VerticalAlignment="Center" Margin="18,0,0,0" ToolTip="Chord being played" />
                <TextBlock Text="● Recording" Foreground="{StaticResource Danger}" VerticalAlignment="Center" Margin="18,0,0,0"
                           Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="0" HorizontalAlignment="Right" Padding="0,10,14,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource TransportButton}" Width="Auto" Height="24" FontSize="12" Padding="10,0" Margin="0,0,14,0" Content="{Binding SpeedLabel}" Click="OnSpeedClick" Focusable="False" ToolTip="Practice speed: slow the music down without changing its pitch" />
                <TextBlock Text="BPM" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Text="{Binding Bpm, UpdateSourceTrigger=LostFocus, StringFormat=0}" Width="52" Height="26" VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Center" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
                         BorderBrush="{StaticResource Border}" CaretBrush="{StaticResource Text}" Margin="0,0,12,0" />
                <Button Style="{StaticResource TransportButton}" Width="Auto" Height="24" FontSize="12" Padding="10,0" Margin="0,0,8,0" Content="Tap" Click="OnTapClick" Focusable="False" ToolTip="Tap the beat to set the BPM" />
                <Button Style="{StaticResource TransportButton}" Width="Auto" Height="24" FontSize="12" Padding="10,0" Margin="0,0,8,0" Content="{Binding SignatureLabel}" Click="OnSignatureClick" Focusable="False" ToolTip="Time signature" />
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding Metronome}" Content="Click" Margin="0,0,8,0" Focusable="False" />
                <Button Style="{StaticResource TransportButton}" Width="Auto" Height="24" FontSize="12" Padding="10,0" Margin="0,0,8,0" Content="{Binding CountInLabel}" Click="OnCountInClick" Focusable="False" ToolTip="Click bars before recording starts" />
                <Button Style="{StaticResource TransportButton}" Width="Auto" Height="24" FontSize="12" Padding="10,0" Margin="0,0,8,0" Content="{Binding WaitLabel}" Click="OnWaitClick" Focusable="False" ToolTip="Start recording and playback when you start playing. Pick how loud the first note must be. Skips the count-in." />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding LoopOn}" Content="Loop" ToolTip="Repeat a range. Loops the selected clip, or the whole song, unless you drag a range on the ruler first. Recording makes one take per pass" Focusable="False" />
                    <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding PunchOn}" Content="Punch" ToolTip="Record only inside the region" Focusable="False" />
                    <Button Style="{StaticResource TransportButton}" Width="Auto" Height="24" FontSize="12" Padding="10,0" Margin="4,0,4,0" Content="{Binding SnapLabel}" Click="OnSnapClick" Focusable="False" ToolTip="Snap regions and clips to the grid" />
                    <Button Style="{StaticResource TransportButton}" Width="Auto" Height="24" FontSize="12" Padding="10,0" Margin="12,0,4,0" Content="Undo" Click="OnUndoClick" Focusable="False" ToolTip="Undo the last change (Ctrl+Z)" />
                    <Button Style="{StaticResource TransportButton}" Width="Auto" Height="24" FontSize="12" Padding="10,0" Margin="0,0,0,0" Content="Redo" Click="OnRedoClick" Focusable="False" ToolTip="Redo (Ctrl+Y)" />
                    <Button Style="{StaticResource TransportButton}" Width="Auto" Height="24" FontSize="12" Padding="10,0" Margin="12,0,4,0" Content="Split" Click="OnSplitClick" Focusable="False" ToolTip="Split the clip at the playhead (S)" />
                    <Button Style="{StaticResource TransportButton}" Width="Auto" Height="24" FontSize="12" Padding="10,0" Margin="0,0,4,0" Content="Duplicate" Click="OnDuplicateClick" Focusable="False" ToolTip="Duplicate the selected clip (Ctrl+D)" />
                    <Button Style="{StaticResource TransportButton}" Width="Auto" Height="24" FontSize="12" Padding="10,0" Margin="0,0,4,0" Content="Delete" Click="OnDeleteClick" Focusable="False" ToolTip="Delete the selected clip (Delete)" />
                    <Button Style="{StaticResource TransportButton}" Width="Auto" Height="24" FontSize="12" Padding="10,0" Margin="12,0,0,0" Content="Quantize" Click="OnQuantizeClick" Focusable="False" ToolTip="Snap the notes of the selected MIDI clip to the grid" />
                    <Button Style="{StaticResource TransportButton}" Width="Auto" Height="24" FontSize="12" Padding="8,0" Margin="2,0,4,0" Content="{Binding QuantizeGridLabel}" Click="OnQuantizeGridClick" Focusable="False" ToolTip="Quantize grid: note value" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding RegionText}" Foreground="{StaticResource TextDim}" FontSize="12" VerticalAlignment="Center" Margin="12,0,12,0" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="ToolsButton" Style="{StaticResource TransportButton}" Width="Auto" Height="24" FontSize="12" Padding="10,0" Margin="0,0,8,0" Content="Tools ▾" Click="OnToolsClick" Focusable="False" ToolTip="Tuner, keyboard, analysis and latency" />
                    <Button x:Name="FileButton" Style="{StaticResource TransportButton}" Width="Auto" Height="24" FontSize="12" Padding="10,0" Margin="0,0,8,0" Content="File ▾" Click="OnFileClick" Focusable="False" ToolTip="Open, import and export" />
                    <Button Style="{StaticResource TransportButton}" Width="64" Height="24" FontSize="12" Margin="0" Content="Save" Click="OnSaveClick" Focusable="False" ToolTip="Save the project" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
            <Border Height="26" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,1" />
            <ItemsControl ItemsSource="{Binding Tracks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Height="{Binding RowHeight}" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,1">
                            <Grid>
                                <Border Width="4" HorizontalAlignment="Left" Background="{Binding Color}" />
                                <StackPanel Margin="16,10,12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" ToolTip="Double-click to rename"
                                                       MouseLeftButtonDown="OnNameMouseDown" Visibility="{Binding IsNotEditing, Converter={StaticResource BoolToVis}}" />
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" FontSize="13" Height="22" Padding="2,0" VerticalContentAlignment="Center"
                                                     Background="{StaticResource Well}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"
                                                     CaretBrush="{StaticResource Text}" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                                     LostFocus="OnNameLostFocus" KeyDown="OnNameKeyDown" />
                                        </Grid>
                                        <Button Grid.Column="1" Style="{StaticResource TransportButton}" Content="{Binding RemoveLabel}" Command="{Binding RemoveCommand}"
                                                Width="Auto" Height="18" FontSize="10" Padding="6,0" Margin="6,0,0,0" Foreground="{StaticResource TextDim}"
                                                ToolTip="Remove track" MouseLeave="OnRemoveMouseLeave" Focusable="False" />
                                    </Grid>
                                    <TextBlock Text="{Binding InputText}" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,1,0,6" Visibility="{Binding IsAudio, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding TakesText}" Foreground="{StaticResource Good}" FontSize="11" Margin="0,-3,0,6" TextWrapping="Wrap" Visibility="{Binding IsMultiLane, Converter={StaticResource BoolToVis}}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,6" Visibility="{Binding IsDrums, Converter={StaticResource BoolToVis}}">
                                        <Button Style="{StaticResource TransportButton}" Content="Drum machine" Click="OnDrumsClick"
                                                Width="Auto" Height="22" FontSize="11" Padding="8,0" Margin="0" ToolTip="Edit drum patterns and place them on the timeline" Focusable="False" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,6" Visibility="{Binding IsMachine, Converter={StaticResource BoolToVis}}">
                                        <Button Style="{StaticResource TransportButton}" Command="{Binding CyclePreset}" Content="{Binding Preset}"
                                                Width="Auto" Height="22" FontSize="11" Padding="8,0" Margin="0,0,6,0" ToolTip="Click to change the sound" Focusable="False" />
                                        <Button Style="{StaticResource TransportButton}" Content="Chords" Click="OnChordsClick"
                                                Width="Auto" Height="22" FontSize="11" Padding="8,0" Margin="0" ToolTip="Edit chord patterns and place them on the timeline" Focusable="False" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,6" Visibility="{Binding IsKeys, Converter={StaticResource BoolToVis}}">
                                        <Button Style="{StaticResource TransportButton}" Command="{Binding CycleMidi}" Content="{Binding MidiLabel}"
                                                Width="Auto" Height="22" FontSize="11" Padding="8,0" Margin="0,0,6,0" ToolTip="Click to switch MIDI input" Focusable="False" />
                                        <Button Style="{StaticResource TransportButton}" Command="{Binding CyclePreset}" Content="{Binding Preset}"
                                                Width="Auto" Height="22" FontSize="11" Padding="8,0" Margin="0,0,6,0" ToolTip="Click to change the sound" Focusable="False" />
                                        <Button Style="{StaticResource TransportButton}" Content="VST" Click="OnEffectsClick"
                                                Width="Auto" Height="22" FontSize="11" Padding="8,0" Margin="0" ToolTip="Play this track through a VST3 instrument" Focusable="False" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton Style="{StaticResource ArmChip}" Content="R" IsChecked="{Binding Armed}" IsEnabled="{Binding HasInput}" ToolTip="Arm for recording" Focusable="False" />
                                        <ToggleButton Style="{StaticResource Chip}" Content="M" IsChecked="{Binding Mute}" ToolTip="Mute" Focusable="False" />
                                        <ToggleButton Style="{StaticResource Chip}" Content="S" IsChecked="{Binding Solo}" ToolTip="Solo" Focusable="False" />
                                        <Button Content="FX" Click="OnEffectsClick" ToolTip="Amp, EQ, compressor and reverb for this track" Focusable="False"
                                                Visibility="{Binding CanHaveEffects, Converter={StaticResource BoolToVis}}" Width="30" Height="24" FontSize="12">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TransportButton}">
                                                    <Setter Property="Foreground" Value="{StaticResource TextDim}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasEffects}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Good}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Vol" FontSize="10" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="1.5" Value="{Binding Gain}" Margin="4,0,10,0" Tag="1" VerticalAlignment="Center"
                                                ToolTip="{Binding GainText}" MouseDoubleClick="OnSliderReset" Focusable="False" />
                                        <TextBlock Grid.Column="2" Text="Pan" FontSize="10" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                                        <Slider Grid.Column="3" Minimum="-1" Maximum="1" Value="{Binding Pan}" Margin="4,0,0,0" Tag="0" VerticalAlignment="Center"
                                                ToolTip="{Binding PanText}" MouseDoubleClick="OnSliderReset" Focusable="False" />
                                    </Grid>
                                    <ProgressBar Maximum="1" Value="{Binding Level, Mode=OneWay}" Height="5" Margin="0,8,0,0" BorderThickness="0"
                                                 Background="{StaticResource Well}" Foreground="{StaticResource Good}">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Clipped}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Style="{StaticResource TransportButton}" Content="+ Add track" Click="OnAddTrackClick" Width="Auto" Height="28" FontSize="12"
                    Padding="12,0" Margin="14,12,0,12" HorizontalAlignment="Left" Focusable="False" />
            </StackPanel>

            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Grid x:Name="LaneArea" Width="{Binding TimelineWidth}" Background="Transparent" MouseLeftButtonDown="OnLaneMouseDown" MouseLeftButtonUp="OnLaneMouseUp" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <local:RulerControl x:Name="Ruler" Grid.Row="0" TimeGrid="{Binding Grid}" Cursor="IBeam" ToolTip="Drag to set a region, click to move the playhead, double-click to clear"
                                        MouseLeftButtonDown="OnRulerDown" MouseMove="OnRulerMove" MouseLeftButtonUp="OnRulerUp" />
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Tracks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="{Binding RowHeight}" Background="{StaticResource Lane}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                                    <Border Background="{Binding DataContext.GridBrush, RelativeSource={RelativeSource AncestorType=Window}}">
                                      <Grid>
                                        <ItemsControl ItemsSource="{Binding MidiClips}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style>
                                                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                    <Setter Property="Canvas.Top" Value="8" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Width="{Binding Width}" Height="108" Background="Transparent" MouseLeftButtonDown="OnClipDown" MouseMove="OnClipMove" MouseLeftButtonUp="OnClipUp">
                                                        <Border Background="{Binding Brush}" Opacity="0.2" CornerRadius="4" />
                                                        <Border BorderBrush="{Binding Brush}" BorderThickness="1" CornerRadius="4" Opacity="0.7" />
                                                        <local:RectsControl Rects="{Binding Notes}" Brush="{Binding Brush}" IsHitTestVisible="False" />
                                                        <Border BorderBrush="White" BorderThickness="2" CornerRadius="4" IsHitTestVisible="False" Visibility="{Binding Selected, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding Strips}" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style>
                                                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Rectangle Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding Fill}" Opacity="{Binding Opacity}" RadiusX="3" RadiusY="3" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding Clips}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style>
                                                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Width="{Binding Width}" Height="{Binding ClipHeight}" Background="Transparent" MouseLeftButtonDown="OnClipDown" MouseMove="OnClipMove" MouseLeftButtonUp="OnClipUp">
                                                        <Border Background="{Binding Brush}" Opacity="0.2" CornerRadius="4" />
                                                        <Border BorderBrush="{Binding Brush}" BorderThickness="1" CornerRadius="4" Opacity="0.7" />
                                                        <local:WaveformControl Peaks="{Binding Peaks}" Brush="{Binding Brush}" Margin="1" IsHitTestVisible="False" />
                                                        <Border BorderBrush="White" BorderThickness="2" CornerRadius="4" IsHitTestVisible="False" Visibility="{Binding Selected, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                      </Grid>
                                    </Border>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Rectangle Grid.RowSpan="2" HorizontalAlignment="Left" Width="{Binding RegionWidth}" Fill="{Binding RegionBrush}" IsHitTestVisible="False"
                               Visibility="{Binding HasRegion, Converter={StaticResource BoolToVis}}">
                        <Rectangle.RenderTransform>
                            <TranslateTransform X="{Binding RegionX}" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle Grid.RowSpan="2" Width="2" HorizontalAlignment="Left" Fill="{StaticResource Danger}" IsHitTestVisible="False">
                        <Rectangle.RenderTransform>
                            <TranslateTransform X="{Binding PlayheadX}" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>
            </ScrollViewer>
        </Grid>
        </ScrollViewer>

        <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="14,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Status}" Foreground="{StaticResource TextDim}" FontSize="12" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding Message}" Foreground="{StaticResource Danger}" FontSize="12" Margin="12,0,0,0" />
                <TextBlock Text="{Binding Notice}" Foreground="{StaticResource TextDim}" FontSize="12" HorizontalAlignment="Right" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
