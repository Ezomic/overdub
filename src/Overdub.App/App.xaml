<Application x:Class="Overdub.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#1B1B1D" />
        <SolidColorBrush x:Key="Well" Color="#0F0F11" />
        <SolidColorBrush x:Key="Panel" Color="#242427" />
        <SolidColorBrush x:Key="Lane" Color="#202023" />
        <SolidColorBrush x:Key="Border" Color="#3A3A3F" />
        <SolidColorBrush x:Key="Text" Color="#E8E8EA" />
        <SolidColorBrush x:Key="TextDim" Color="#9A9AA2" />
        <SolidColorBrush x:Key="Danger" Color="#E5484D" />
        <SolidColorBrush x:Key="DangerBg" Color="#4A2023" />
        <SolidColorBrush x:Key="Active" Color="#34343A" />
        <SolidColorBrush x:Key="Good" Color="#46A758" />

        <Style x:Key="Chip" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Box" Background="Transparent" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Padding="8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Active}" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ArmChip" TargetType="ToggleButton" BasedOn="{StaticResource Chip}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="{StaticResource DangerBg}" BorderBrush="{StaticResource Danger}" BorderThickness="1" CornerRadius="4" Padding="8,0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{StaticResource Danger}" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="Transparent" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Active}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
